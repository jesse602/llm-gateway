# Base URL of the Ollama instance the gateway proxies to
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated list of valid API keys. In production, inject via a k8s Secret.
LLM_GATEWAY_API_KEYS=dev-key-change-me

# Requests allowed per API key per RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Max concurrent requests forwarded to Ollama at once (protects the single GPU)
MAX_CONCURRENCY=2

# Seconds a request waits in queue for a free slot before failing with 503
QUEUE_TIMEOUT_SECONDS=60
